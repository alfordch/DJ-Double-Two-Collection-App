# dependencies
node_modules/

# build output
dist/
build/
*.tsbuildinfo

# environment files and secrets
.env
.env.*
!.env.example

# logs
logs/
*.log
npm-debug.log*

# editor and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp

